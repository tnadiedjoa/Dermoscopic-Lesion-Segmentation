# Local-only exports of the executed notebook (kept out of the repo for size).
# HTML:  python -m nbconvert --to html --embed-images --output-dir report \
#            --output notebook_export notebooks/01_method_comparison.ipynb
# PDF:   same with --to pdf (needs pandoc and a LaTeX install)
report/notebook_export.pdf
report/notebook_export.html

# LaTeX build artefacts for report/report.pdf. The source, the table
# generator and the generated tables are tracked, so the PDF can be rebuilt
# straight from the repo:
#   python report/make_results_table.py
#   cd report && pdflatex report.tex
report/*.aux
report/*.log
report/*.out
